# Copy to .env.local for development, or set these in the deployment environment.
# The server refuses to start in production if any required value is missing
# — see src/instrumentation.ts.

# PostgreSQL 16+ with the cube and earthdistance extensions available.
DATABASE_URL=postgres://user@localhost:5432/field_register

# Signs the session cookie. There is no default: a predictable key lets anyone
# mint a session for anyone. At least 32 characters.
#   openssl rand -base64 48
# Changing it signs everybody out, which is how you revoke every session at once.
FR_SESSION_SECRET=

# Keys phone-number hashes so they cannot be recovered with a prepared lookup
# table after a database leak. Use a separate value and do not rotate it casually.
#   openssl rand -base64 48
FR_PHONE_PEPPER=

# Durable directory for uploaded field evidence. Mount this path on persistent
# storage in production; the container example uses /app/data/media.
FR_MEDIA_ROOT=.data/media

# Optional PostgreSQL pool size per application instance (1-30, default 10).
# FR_DB_POOL_SIZE=10

# The no-password user picker is available only outside production. Set this to
# 0 locally when you want to exercise the real sign-in and activation flows.
# FR_ALLOW_DEV_SIGNIN=0
